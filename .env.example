# ============================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo como .env y completa los valores reales.
# El archivo .env NO se sube al repositorio.
# ============================================

# Puerto del servidor
PORT=3000

# Clave secreta para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=tu_clave_secreta_muy_larga_y_aleatoria

# Tiempo de vida del token JWT en segundos
JWT_EXPIRES_IN=3600

# Orígenes permitidos para conexiones WebSocket (separados por comas)
# Usa "*" para permitir todos. Agrega tu IP local para probar desde otro dispositivo.
ALLOWED_ORIGINS=localhost,127.0.0.1

# Límites de validación
MAX_MESSAGE_LENGTH=500
MAX_USERNAME_LENGTH=20

# ============================================
# FIREBASE - Configuración de la app web
# Firebase Console > Configuración del proyecto > Tus apps
# ============================================
FIREBASE_API_KEY=tu_api_key
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# ============================================
# FIREBASE ADMIN SDK - Clave privada
# Firebase Console > Configuración del proyecto > Cuentas de servicio
# > Generar nueva clave privada. Coloca el .json en la raíz del proyecto.
# ESTE ARCHIVO NUNCA DEBE SUBIRSE AL REPOSITORIO.
# ============================================
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
